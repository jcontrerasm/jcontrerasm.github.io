---
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const label = lang === 'es' ? 'Volver arriba' : 'Back to top';
---

<button type="button" class="back-to-top" aria-label={label} title={label} hidden>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 5rem;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--color-text-primary);
    background: var(--color-text-primary);
    color: var(--color-bg);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    opacity: 0.82;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.back-to-top');
  if (btn) {
    btn.hidden = false;
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const nearEnd = scrollable > 0 && window.scrollY > scrollable - 400;
      btn.classList.toggle('visible', nearEnd);
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
