---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../config';

interface Props {
  lang: 'es' | 'en';
  translationHref?: string;
}

const { lang, translationHref } = Astro.props;
const items = NAV[lang];
const contactLabel = lang === 'es' ? 'Contacto' : 'Contact';
const contactHref = lang === 'es' ? '/es/contacto/' : '/en/contact/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`/${lang}/`}>
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-role">{SITE.role[lang]}</span>
    </a>
    <nav class="nav">
      {items.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <LanguageSwitcher lang={lang} translationHref={translationHref} />
      <ThemeToggle />
      <a class="btn btn-accent contact-cta" href={contactHref}>{contactLabel}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--masthead-h);
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-role {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav a {
    color: var(--color-text-secondary);
  }

  .nav a:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .contact-cta {
    padding: 0.5rem 1rem;
  }

  @media (max-width: 560px) {
    .nav a:not(.contact-cta):not(.lang-switch) {
      display: none;
    }
  }
</style>
