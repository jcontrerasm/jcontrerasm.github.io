---
// Renderiza en el cliente los bloques ```mermaid de los artículos.
// Mermaid solo se descarga si la página tiene diagramas y se vuelve a
// dibujar al cambiar el tema para usar los colores de global.css.
// Cada diagrama se puede abrir en un visor ampliado con zoom.

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const labels = {
  es: { expand: 'Ver en grande', close: 'Cerrar', zoomIn: 'Acercar', zoomOut: 'Alejar', reset: 'Ajustar' },
  en: { expand: 'View larger', close: 'Close', zoomIn: 'Zoom in', zoomOut: 'Zoom out', reset: 'Fit' },
}[lang];
---

<dialog class="mermaid-viewer" id="mermaid-viewer" data-expand-label={labels.expand}>
  <div class="mermaid-viewer-toolbar">
    <button type="button" data-zoom="out" aria-label={labels.zoomOut} title={labels.zoomOut}>−</button>
    <button type="button" data-zoom="reset" aria-label={labels.reset} title={labels.reset}>{labels.reset}</button>
    <button type="button" data-zoom="in" aria-label={labels.zoomIn} title={labels.zoomIn}>+</button>
    <button type="button" data-close aria-label={labels.close} title={labels.close}>✕</button>
  </div>
  <div class="mermaid-viewer-body"></div>
</dialog>

<script>
  async function init() {
    const blocks = [...document.querySelectorAll<HTMLElement>('pre > code.language-mermaid')];
    const viewer = document.getElementById('mermaid-viewer') as HTMLDialogElement | null;
    if (!blocks.length || !viewer) return;

    const viewerBody = viewer.querySelector<HTMLElement>('.mermaid-viewer-body')!;
    let zoom = 1;
    const setZoom = (value: number) => {
      zoom = Math.min(4, Math.max(0.5, value));
      viewerBody.style.setProperty('--zoom', String(zoom));
    };

    const openViewer = (container: HTMLElement) => {
      viewerBody.innerHTML = container.querySelector('.mermaid-svg')!.innerHTML;
      setZoom(1);
      viewer.showModal();
    };

    viewer.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-zoom]')?.dataset.zoom;
      if (action === 'in') setZoom(zoom + 0.25);
      else if (action === 'out') setZoom(zoom - 0.25);
      else if (action === 'reset') setZoom(1);
      // Cierra con el botón o al hacer clic en el fondo
      else if (target.closest('[data-close]') || target === viewer) viewer.close();
    });
    viewer.addEventListener('close', () => (viewerBody.innerHTML = ''));

    const diagrams = blocks.map((code) => {
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      container.dataset.source = code.textContent ?? '';
      container.innerHTML = '<div class="mermaid-svg"></div>';

      const expand = document.createElement('button');
      expand.type = 'button';
      expand.className = 'mermaid-expand';
      expand.textContent = '⤢';
      expand.setAttribute('aria-label', viewer.dataset.expandLabel!);
      expand.title = viewer.dataset.expandLabel!;
      expand.addEventListener('click', () => openViewer(container));
      container.querySelector('.mermaid-svg')!.addEventListener('click', () => openViewer(container));
      container.append(expand);

      code.parentElement!.replaceWith(container);
      return container;
    });

    const { default: mermaid } = await import('mermaid');

    const token = (name: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    let renderCount = 0;
    const render = async () => {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: token('--font-body'),
        themeVariables: {
          background: token('--color-bg'),
          primaryColor: token('--color-accent-tint'),
          primaryBorderColor: token('--color-accent'),
          primaryTextColor: token('--color-text-primary'),
          secondaryColor: token('--color-surface-raised'),
          tertiaryColor: token('--color-surface'),
          lineColor: token('--color-text-secondary'),
          textColor: token('--color-text-primary'),
          clusterBkg: token('--color-surface-raised'),
          clusterBorder: token('--color-border-strong'),
          edgeLabelBackground: token('--color-bg'),
          actorBkg: token('--color-accent-tint'),
          actorBorder: token('--color-accent'),
          actorTextColor: token('--color-text-primary'),
          actorLineColor: token('--color-border-strong'),
          signalColor: token('--color-text-secondary'),
          signalTextColor: token('--color-text-primary'),
          noteBkgColor: token('--color-surface-raised'),
          noteBorderColor: token('--color-border-strong'),
          noteTextColor: token('--color-text-primary'),
        },
      });
      for (const container of diagrams) {
        const { svg } = await mermaid.render(`mermaid-${renderCount++}`, container.dataset.source!);
        container.querySelector('.mermaid-svg')!.innerHTML = svg;
      }
    };

    await render();

    new MutationObserver(render).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
  }

  init();
</script>

<style is:global>
  .mermaid-diagram {
    position: relative;
    margin: 1.75rem 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    overflow-x: auto;
    text-align: center;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }

  .mermaid-svg {
    cursor: zoom-in;
  }

  .mermaid-expand,
  .mermaid-viewer-toolbar button {
    font: inherit;
    color: var(--color-text-mid);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
  }

  .mermaid-expand {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    line-height: 1;
  }

  .mermaid-expand:hover,
  .mermaid-viewer-toolbar button:hover {
    color: var(--color-accent);
    border-color: var(--color-border-strong);
  }

  .mermaid-viewer {
    width: calc(100vw - 2rem);
    max-width: none;
    height: calc(100dvh - 2rem);
    max-height: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .mermaid-viewer[open] {
    display: flex;
    flex-direction: column;
  }

  .mermaid-viewer::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .mermaid-viewer-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mermaid-viewer-toolbar button {
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.6rem;
    font-size: 0.85rem;
  }

  .mermaid-viewer-body {
    --zoom: 1;
    flex: 1;
    overflow: auto;
    padding: 1.5rem;
    display: flex;
  }

  /* margin: auto centra el diagrama y, al ampliarlo, deja desplazarse hacia todos los lados */
  .mermaid-viewer-body svg {
    margin: auto;
    flex-shrink: 0;
    width: calc(100% * var(--zoom));
    max-width: none !important;
    height: auto;
    max-height: none;
  }
</style>
