---
interface Props {
  images: string[];
  alt: string;
  closeLabel?: string;
  intervalMs?: number;
}

const { images, alt, closeLabel = 'Cerrar', intervalMs = 5000 } = Astro.props;
---

{images.length > 0 && (
  <div class="photo-carousel" data-interval={intervalMs}>
    <div class="carousel-viewport" role="button" tabindex="0" aria-label={alt}>
      {images.map((file, i) => (
        <img
          src={`/images/${file}`}
          alt={alt}
          class={`carousel-slide ${i === 0 ? 'is-active' : ''}`}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))}
      <span class="carousel-zoom-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /><path d="M11 8v6M8 11h6" />
        </svg>
      </span>
    </div>

    {images.length > 1 && (
      <div class="carousel-dots">
        {images.map((_, i) => (
          <button
            type="button"
            class={`carousel-dot ${i === 0 ? 'is-active' : ''}`}
            data-index={i}
            aria-label={`${i + 1}/${images.length}`}
          />
        ))}
      </div>
    )}
  </div>

  <div class="carousel-lightbox" data-close-label={closeLabel}>
    <button type="button" class="carousel-lightbox-close" aria-label={closeLabel}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <img class="carousel-lightbox-img" src="" alt="" />
  </div>
)}

<style>
  .photo-carousel {
    position: relative;
  }

  .carousel-viewport {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    cursor: zoom-in;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .carousel-slide.is-active {
    opacity: 1;
  }

  .carousel-zoom-hint {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(16, 16, 18, 0.55);
    color: #f4f4f2;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
    pointer-events: none;
  }

  .carousel-viewport:hover .carousel-zoom-hint,
  .carousel-viewport:focus-visible .carousel-zoom-hint {
    opacity: 1;
    transform: scale(1);
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border-strong);
    cursor: pointer;
    transition: background 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .carousel-dot.is-active {
    background: var(--color-accent);
    transform: scale(1.3);
  }

  .carousel-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5vh 5vw;
    background: rgba(10, 10, 11, 0);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      background 0.3s var(--ease);
  }

  .carousel-lightbox.is-open {
    background: rgba(10, 10, 11, 0.86);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .carousel-lightbox-img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    transform: scale(0.92);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s var(--ease);
  }

  .carousel-lightbox.is-open .carousel-lightbox-img {
    transform: scale(1);
    opacity: 1;
  }

  .carousel-lightbox-close {
    position: absolute;
    top: clamp(1rem, 3vh, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid rgba(244, 244, 242, 0.25);
    background: rgba(255, 255, 255, 0.06);
    color: var(--hero-ink);
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .carousel-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: scale(1.06);
  }
</style>

<script>
  function initPhotoCarousels() {
    document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((carousel) => {
      if (carousel.dataset.initialized === 'true') return;
      carousel.dataset.initialized = 'true';

      const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>('.carousel-slide'));
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
      const viewport = carousel.querySelector<HTMLElement>('.carousel-viewport');
      const intervalMs = Number(carousel.dataset.interval) || 5000;
      let current = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      const goTo = (index: number) => {
        if (slides.length === 0) return;
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };

      const start = () => {
        if (slides.length < 2) return;
        stop();
        timer = setInterval(() => goTo(current + 1), intervalMs);
      };

      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          goTo(i);
          start();
        });
      });

      carousel.addEventListener('mouseenter', stop);
      carousel.addEventListener('mouseleave', start);

      const lightbox = document.querySelector<HTMLElement>('.carousel-lightbox');
      const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.carousel-lightbox-img');
      const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.carousel-lightbox-close');

      const openLightbox = () => {
        if (!lightbox || !lightboxImg) return;
        const active = slides[current];
        lightboxImg.src = active.src;
        lightboxImg.alt = active.alt;
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      };

      viewport?.addEventListener('click', openLightbox);
      viewport?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox();
        }
      });

      closeBtn?.addEventListener('click', closeLightbox);
      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });

      start();
    });
  }

  initPhotoCarousels();
  document.addEventListener('astro:page-load', initPhotoCarousels);
</script>
