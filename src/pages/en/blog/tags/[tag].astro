---
import { getCollection } from 'astro:content';
import { isVisible } from '../../../../utils/posts';
import Layout from '../../../../layouts/Layout.astro';
import BlogPostCard from '../../../../components/BlogPostCard.astro';
import { SITE } from '../../../../config';
import { slugify } from '../../../../utils/slug';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en' && isVisible(p));
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout
  lang="en"
  title={`#${tag} — Articles — ${SITE.name}`}
  description={`Posts tagged with ${tag}.`}
  translationHref="/es/blog/"
>
  <section class="container blog-index">
    <h1>#{tag}</h1>
    <div class="post-grid">
      {posts.map((post) => (
        <BlogPostCard
          href={`/en/blog/${post.id.replace(/^en\//, '')}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang="en"
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .blog-index {
    padding: 3rem 1.5rem 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
</style>
