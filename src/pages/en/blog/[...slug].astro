---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.id.startsWith('en/') && !p.data.draft);
  const esPosts = await getCollection('blog', (p) => p.id.startsWith('es/') && !p.data.draft);
  const esBasenames = new Set(esPosts.map((p) => p.id.replace(/^es\//, '')));

  return posts.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    const translationHref = esBasenames.has(slug) ? `/es/blog/${slug}/` : '/es/blog/';
    return { params: { slug }, props: { entry, translationHref } };
  });
}

const { entry, translationHref } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost entry={entry} translationHref={translationHref}>
  <Content />
</BlogPost>
