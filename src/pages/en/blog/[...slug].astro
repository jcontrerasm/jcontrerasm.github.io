---
import { getCollection, render } from 'astro:content';
import { isVisible } from '../../../utils/posts';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.id.startsWith('en/') && isVisible(p));
  const esPosts = await getCollection('blog', (p) => p.id.startsWith('es/') && isVisible(p));
  const esBasenames = new Set(esPosts.map((p) => p.id.replace(/^es\//, '')));

  return posts.map((entry) => {
    const slug = entry.id.replace(/^en\//, '');
    const alternateHref = esBasenames.has(slug) ? `/es/blog/${slug}/` : undefined;
    const translationHref = alternateHref ?? '/es/blog/';
    return { params: { slug }, props: { entry, translationHref, alternateHref } };
  });
}

const { entry, translationHref, alternateHref } = Astro.props;
const { Content, headings } = await render(entry);
---

<BlogPost entry={entry} translationHref={translationHref} alternateHref={alternateHref} headings={headings}>
  <Content />
</BlogPost>
