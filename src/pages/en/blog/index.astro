---
import Layout from '../../../layouts/Layout.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../../config';

const posts = (await getCollection('blog', (p) => p.data.lang === 'en' && !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  lang="en"
  title={`Blog — ${SITE.name}`}
  description="Articles on DevSecOps, engineering culture, metrics, and applied AI."
  translationHref="/es/blog/"
>
  <section class="container blog-index">
    <h1>Blog</h1>
    <div class="post-grid">
      {posts.map((post) => (
        <BlogPostCard
          href={`/en/blog/${post.id.replace(/^en\//, '')}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang="en"
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .blog-index {
    padding: 3rem 1.5rem 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
</style>
