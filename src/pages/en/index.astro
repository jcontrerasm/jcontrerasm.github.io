---
import fs from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import HeroTerminal from '../../components/HeroTerminal.astro';
import CertificationCard from '../../components/CertificationCard.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import DevSecOpsPipeline from '../../components/DevSecOpsPipeline.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../utils/posts';
import { SITE } from '../../config';

const imagesDir = new URL('../../../public/images/', import.meta.url);
const galleryImages = fs
  .readdirSync(imagesDir)
  .filter((file) => file.startsWith('gallery_'))
  .sort();

const posts = (await getCollection('blog', (p) => p.data.lang === 'en' && isPublished(p)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const softSkills = [
  { type: 'cmd', text: 'cat leadership.txt' },
  { type: 'out', text: 'Promoting DevSecOps and AI culture' },
  { type: 'cmd', text: 'cat communication.txt' },
  { type: 'out', text: 'Conferences, trainings, and executive reporting' },
  { type: 'cmd', text: 'cat innovation.txt' },
  { type: 'out', text: 'Early adoption of AI and new technologies' },
  { type: 'cmd', text: 'cat learning.txt' },
  { type: 'out', text: 'Continuous learning and certifications' },
  { type: 'cmd', text: 'cat strategy.txt' },
  { type: 'out', text: 'Architecture decisions and engineering standards' },
  { type: 'cmd', text: 'cat thinking.txt' },
  { type: 'out', text: 'Analytical, metrics-driven thinking' },
  { type: 'ok', text: '✔ Continuous improvement' },
] as const;

const techSkills = [
  { type: 'cmd', text: 'ls ai/' },
  { type: 'out', text: 'Autonomous Agents (GH Copilot · Claude · MS Foundry)' },
  { type: 'out', text: 'APM · MCP · Copilot Studio · AI Search' },
  { type: 'cmd', text: 'ls platform/' },
  { type: 'out', text: 'GitHub · Azure DevOps · GitLab · Azure · GCP · AWS' },
  { type: 'cmd', text: 'ls tools/' },
  { type: 'out', text: 'Terraform · Ansible · Helm · Docker · Kubernetes' },
  { type: 'out', text: 'Jenkins · GitHub Actions · Azure Pipelines' },
  { type: 'out', text: 'Prometheus · Grafana · Dynatrace' },
  { type: 'out', text: 'SonarCloud · Snyk' },
  { type: 'cmd', text: 'ls data/' },
  { type: 'out', text: 'Engineering metrics (DORA · SPACE · DevEx)' },
  { type: 'ok', text: '✔ Production ready' },
] as const;

const certifications = [
  {
    title: 'GitHub Foundations',
    issuer: 'GitHub',
    image: '/images/certs/github-foundations.png',
    href: 'https://www.credly.com/badges/659c8266-1e27-47e8-a170-69df618c80e1/linked_in_profile',
  },
  {
    title: 'GitHub Actions',
    issuer: 'GitHub',
    image: '/images/certs/github-actions.png',
    href: 'https://www.credly.com/badges/f642cb13-5b6a-49e3-894e-a24da3767921/linked_in_profile',
  },
  {
    title: 'GitHub Copilot',
    issuer: 'GitHub',
    image: '/images/certs/github-copilot.png',
    href: 'https://learn.microsoft.com/api/credentials/share/en-us/JuanCarlosContrerasMeneses-6257/D467DF14CDA08CB1?sharingId',
  },
];
---

<Layout
  lang="en"
  title={`${SITE.name} — DevSecOps Architect`}
  description="DevSecOps Architect focused on security, engineering culture, metrics, and applied AI."
  translationHref="/es/"
  alternateHref="/es/"
>
  <section class="hero">
    <DevSecOpsPipeline />
    <div class="container hero-inner">
      <img class="hero-photo" src="/images/profile.jpeg" alt={SITE.name} width="220" height="220" />
      <div class="hero-text">
        <p class="eyebrow hero-eyebrow">DevSecOps Architect</p>
        <h1 class="hero-title">{SITE.name}</h1>
        <p class="lede">
          DevSecOps &amp; AI Architect | Scaling the SDLC with AI Agents | Innovation Mentor &amp;
          Speaker
        </p>
        <div class="cta">
          <a class="btn btn-accent" href="/en/blog/">Read articles</a>
          <a class="btn btn-ghost" href="/en/contact/">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container bio">
    <div class="bio-text">
      <h2>About me</h2>
      <p>
        DevSecOps Architect with more than 9 years of experience across the software lifecycle,
        from frontend and backend development to cloud infrastructure on AWS, GCP, and Azure.
        Before joining Pacífico Seguros (Credicorp Group), I worked at Intercorp Retail and
        IndigitalXP (Intercorp Group) and Orbis Ventures (El Comercio Group), where I built
        platforms, pipelines, and microservices.
      </p>
      <p>
        Today I lead the adoption of artificial intelligence across the SDLC: I define governance,
        policies, and tooling, build AI agents and extend their capabilities with skills, MCPs, and
        RAG, using agentic patterns and security best practices, as well as quantifying their benefit for
        management and the entire company.
      </p>
      <p>
        I promote DevSecOps culture and the use of AI inside and outside the company through talks,
        training, and mentoring.
      </p>
      <p class="eyebrow bio-links-eyebrow">Connect</p>
      <ul class="bio-links">
        <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg><span>LinkedIn</span></a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg><span>GitHub</span></a></li>
        <li><a href={SITE.medium} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 1 1-6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42S14.2 15.54 14.2 12s1.52-6.42 3.38-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75S21.62 15.17 21.62 12s.53-5.75 1.19-5.75S24 8.83 24 12z"/></svg><span>Medium</span></a></li>
        <li><span class="soon" role="link" aria-disabled="true" tabindex="0"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg><span class="soon-text"><span class="soon-label">YouTube</span><span class="soon-hover" aria-hidden="true">Coming soon</span></span></span></li>
      </ul>
    </div>

    {galleryImages.length > 0 && (
      <div class="bio-gallery">
        <p class="eyebrow gallery-eyebrow">Talks &amp; events</p>
        <PhotoCarousel
          images={galleryImages}
          alt="Juan Carlos Contreras giving a talk"
          closeLabel="Close"
        />
      </div>
    )}
  </section>

  <section class="container certifications">
    <h2>Certifications</h2>
    <div class="cert-grid">
      {certifications.map((cert) => (
        <CertificationCard
          title={cert.title}
          issuer={cert.issuer}
          image={cert.image}
          href={cert.href}
          alt={`${cert.title} certification badge`}
        />
      ))}
    </div>
  </section>

  <section class="container skills">
    <h2>Skills</h2>
    <div class="skills-grid">
      <HeroTerminal title="soft-skills.sh" lines={softSkills} />
      <HeroTerminal title="technical-skills.sh" lines={techSkills} />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="container latest">
      <h2>Latest posts</h2>
      <div class="post-grid">
        {posts.map((post) => (
          <BlogPostCard
            href={`/en/blog/${post.id.replace(/^en\//, '')}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            lang="en"
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(64px, 8vh, 110px) 1.5rem 130px;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .hero-photo {
    flex-shrink: 0;
    width: clamp(120px, 16vw, 180px);
    height: clamp(120px, 16vw, 180px);
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    border: 1px solid var(--hero-rule);
  }

  .hero-text {
    min-width: 0;
    flex: 1;
  }

  .lede {
    color: var(--hero-ink-2);
    font-size: 1.15rem;
    max-width: 34rem;
  }

  @media (max-width: 640px) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 100px;
    }
  }

  .hero-eyebrow {
    color: var(--hero-ink-3);
    padding-bottom: 14px;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--hero-rule);
  }

  .hero-title {
    font-size: clamp(40px, 5.4vw, 45px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 0 0 30px;
    color: #39b8ff;
  }

  .cta {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cta .btn-accent {
    background: var(--hero-ink);
    color: var(--hero-bg);
    border-color: var(--hero-ink);
  }

  .cta .btn-ghost {
    border-color: var(--hero-rule);
    color: var(--hero-ink-2);
  }

  .cta .btn-ghost:hover {
    border-color: var(--hero-ink);
    color: var(--hero-ink);
  }

  .bio {
    max-width: var(--page-width);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .bio-text {
    min-width: 0;
    max-width: var(--content-width);
  }

  .bio-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .bio-links-eyebrow {
    margin: 2rem 0 1rem;
  }

  .bio-links a,
  .bio-links .soon {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      background 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .bio-links a:hover,
  .bio-links a:focus-visible {
    background: var(--color-text-primary);
    border-color: var(--color-text-primary);
    color: var(--color-bg);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .bio-links .soon {
    cursor: default;
  }

  .soon-text {
    display: inline-grid;
  }

  .soon-text > span {
    grid-area: 1 / 1;
  }

  .soon-hover {
    visibility: hidden;
  }

  .bio-links .soon:hover .soon-label,
  .bio-links .soon:focus-visible .soon-label {
    visibility: hidden;
  }

  .bio-links .soon:hover .soon-hover,
  .bio-links .soon:focus-visible .soon-hover {
    visibility: visible;
  }

  .bio-links svg {
    flex-shrink: 0;
  }

  .bio-gallery {
    min-width: 0;
    max-width: 320px;
    width: 100%;
  }

  .gallery-eyebrow {
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .bio {
      grid-template-columns: 1fr;
    }

    .bio-gallery {
      max-width: 320px;
    }
  }

  .certifications {
    padding-bottom: 3rem;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .skills {
    padding-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 800px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .latest {
    padding-bottom: 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
