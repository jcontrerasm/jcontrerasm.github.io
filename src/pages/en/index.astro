---
import Layout from '../../layouts/Layout.astro';
import FocusAreaCard from '../../components/FocusAreaCard.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import DevSecOpsPipeline from '../../components/DevSecOpsPipeline.astro';
import HeroTerminal from '../../components/HeroTerminal.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config';

const terminalLines = [
  { type: 'cmd', text: 'gh copilot agent run --fix-dependabot' },
  { type: 'out', text: 'scanning 482 dependencies...' },
  { type: 'out', text: '7 critical, 12 high found' },
  { type: 'ok', text: 'lockfile patched ✓' },
  { type: 'ok', text: 'tests: 128/128 ✓' },
  { type: 'ok', text: 'PR #482 opened for review ✓' },
] as const;

const posts = (await getCollection('blog', (p) => p.data.lang === 'en' && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const focusAreas = [
  {
    title: 'DevSecOps Architecture',
    description: 'Embedding security across the software lifecycle, from design through production.',
  },
  {
    title: 'Engineering Culture',
    description: 'Leading cultural transformation initiatives across engineering teams.',
  },
  {
    title: 'Engineering Metrics',
    description: 'Defining and tracking technical metrics that inform decisions across the org.',
  },
  {
    title: 'AI for Security & Ops',
    description: 'Using AI agents to accelerate vulnerability remediation and other workflows.',
  },
];
---

<Layout
  lang="en"
  title={`${SITE.name} — DevSecOps Architect`}
  description="DevSecOps Architect focused on security, engineering culture, metrics, and applied AI."
  translationHref="/es/"
>
  <section class="hero">
    <DevSecOpsPipeline />
    <div class="container hero-inner">
      <div class="hero-identity">
        <img class="hero-photo" src="/images/profile.jpeg" alt={SITE.name} width="220" height="220" />
        <div class="hero-text">
          <p class="eyebrow hero-eyebrow">DevSecOps Architect</p>
          <h1 class="hero-title">{SITE.name}</h1>
          <p class="lede">
            I bring security, engineering culture, and data together across the software lifecycle. I
            share what I learn along the way on the blog.
          </p>
          <div class="cta">
            <a class="btn btn-accent" href="/en/blog/">Read the blog</a>
            <a class="btn btn-ghost" href="/en/contact/">Contact</a>
          </div>
        </div>
      </div>
      <div class="hero-terminal-wrap">
        <HeroTerminal title="remediate.sh" lines={terminalLines} />
      </div>
    </div>
  </section>

  <section class="container focus-grid">
    {focusAreas.map((area, index) => (
      <FocusAreaCard title={area.title} description={area.description} index={index} />
    ))}
  </section>

  <section class="container bio">
    <h2>About me</h2>
    <p>
      I currently lead engineering culture transformation initiatives, technical metrics tracking
      across the company, and applied AI projects — including using GitHub Copilot's agent mode
      to mass-remediate vulnerabilities flagged by Dependabot, a case I presented at a joint
      Credicorp, Microsoft, and GitHub event.
    </p>
  </section>

  {posts.length > 0 && (
    <section class="container latest">
      <h2>Latest posts</h2>
      <div class="post-grid">
        {posts.map((post) => (
          <BlogPostCard
            href={`/en/blog/${post.id.replace(/^en\//, '')}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            lang="en"
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(64px, 8vh, 110px) 1.5rem 130px;
    max-width: var(--page-width);
    margin: 0;
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    flex-shrink: 0;
    max-width: var(--content-width);
  }

  .hero-photo {
    flex-shrink: 0;
    width: clamp(120px, 16vw, 180px);
    height: clamp(120px, 16vw, 180px);
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    border: 1px solid var(--hero-rule);
  }

  .hero-text {
    min-width: 0;
  }

  .hero-terminal-wrap {
    flex: 1;
    min-width: 280px;
    max-width: 380px;
  }

  @media (max-width: 900px) {
    .hero-terminal-wrap {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 100px;
    }

    .hero-identity {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .hero-eyebrow {
    color: var(--hero-ink-3);
    padding-bottom: 14px;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--hero-rule);
  }

  .hero-title {
    font-size: clamp(40px, 5.4vw, 74px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 0 0 30px;
    color: var(--palette-bright-blue);
  }

  .lede {
    color: var(--hero-ink-2);
    font-size: 1.15rem;
    max-width: 34rem;
  }

  .cta {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cta .btn-accent {
    background: var(--hero-ink);
    color: var(--hero-bg);
    border-color: var(--hero-ink);
  }

  .cta .btn-ghost {
    border-color: var(--hero-rule);
    color: var(--hero-ink-2);
  }

  .cta .btn-ghost:hover {
    border-color: var(--hero-ink);
    color: var(--hero-ink);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    padding: 3rem 0;
  }

  .bio {
    max-width: var(--content-width);
    padding-bottom: 3rem;
  }

  .latest {
    padding-bottom: 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
