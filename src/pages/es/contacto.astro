---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../config';
---

<Layout
  lang="es"
  title={`Contacto — ${SITE.name}`}
  description="Ponte en contacto conmigo por LinkedIn o GitHub."
  translationHref="/en/contact/"
>
  <section class="container contact">
    <h1>Contacto</h1>
    <p class="lede">
      La forma más directa de contactarme es por LinkedIn. También puedes revisar mis proyectos en
      GitHub.
    </p>
    <div class="links">
      <a class="btn btn-accent" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
        Escríbeme en LinkedIn
      </a>
      <a class="btn" href={SITE.github} target="_blank" rel="noopener noreferrer">
        Ver GitHub
      </a>
    </div>
  </section>
</Layout>

<style>
  .contact {
    padding: 4rem 1.5rem;
    max-width: var(--content-width);
  }

  .lede {
    color: var(--color-text-secondary);
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
</style>
