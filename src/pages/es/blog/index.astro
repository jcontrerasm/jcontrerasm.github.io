---
import Layout from '../../../layouts/Layout.astro';
import BlogFilter from '../../../components/BlogFilter.astro';
import BlogPostCard from '../../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { isVisible } from '../../../utils/posts';
import { SITE } from '../../../config';

const posts = (await getCollection('blog', (p) => p.data.lang === 'es' && isVisible(p))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  lang="es"
  title={`Artículos — ${SITE.fullName}`}
  description="Artículos sobre DevSecOps, cultura de ingeniería, métricas e IA aplicada."
  translationHref="/en/blog/"
  alternateHref="/en/blog/"
>
  <section class="container blog-index">
    <h1>Artículos</h1>
    <BlogFilter lang="es" tags={posts.flatMap((p) => p.data.tags)} />
    <div class="post-grid" id="post-grid">
      {posts.map((post) => (
        <BlogPostCard
          href={`/es/blog/${post.id.replace(/^es\//, '')}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang="es"
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .blog-index {
    padding: 3rem 1.5rem 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
</style>
