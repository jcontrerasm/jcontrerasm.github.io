---
import fs from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import FocusAreaCard from '../../components/FocusAreaCard.astro';
import CertificationCard from '../../components/CertificationCard.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import DevSecOpsPipeline from '../../components/DevSecOpsPipeline.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config';

const imagesDir = new URL('../../../public/images/', import.meta.url);
const galleryImages = fs
  .readdirSync(imagesDir)
  .filter((file) => file.startsWith('gallery_'))
  .sort();

const posts = (await getCollection('blog', (p) => p.data.lang === 'es' && !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const focusAreas = [
  {
    title: 'Arquitectura DevSecOps',
    description: 'Integro seguridad en el ciclo de vida del software, desde el diseño hasta producción.',
  },
  {
    title: 'Cultura de Ingeniería',
    description: 'Lidero iniciativas de transformación cultural para equipos de desarrollo.',
  },
  {
    title: 'Métricas de Ingeniería',
    description: 'Defino y sigo métricas técnicas que orientan decisiones dentro de la organización.',
  },
  {
    title: 'IA aplicada a Seguridad y Ops',
    description: 'Uso agentes de IA para acelerar la remediación de vulnerabilidades y otros flujos de trabajo.',
  },
];

const certifications = [
  { title: 'GitHub Foundations', issuer: 'GitHub', image: '/images/certs/github-foundations.png' },
  { title: 'GitHub Actions', issuer: 'GitHub', image: '/images/certs/github-actions.png' },
  { title: 'GitHub Copilot', issuer: 'GitHub', image: '/images/certs/github-copilot.png' },
];
---

<Layout
  lang="es"
  title={`${SITE.name} — Arquitecto DevSecOps`}
  description="Arquitecto DevSecOps enfocado en seguridad, cultura de ingeniería, métricas e IA aplicada."
  translationHref="/en/"
>
  <section class="hero">
    <DevSecOpsPipeline />
    <div class="container hero-inner">
      <img class="hero-photo" src="/images/profile.jpeg" alt={SITE.name} width="220" height="220" />
      <div class="hero-text">
        <p class="eyebrow hero-eyebrow">Arquitecto DevSecOps</p>
        <h1 class="hero-title">{SITE.name}</h1>
        <p class="lede">
          Integro seguridad, cultura de ingeniería y datos en el ciclo de vida del software. Comparto
          lo que aprendo en el camino en el blog.
        </p>
        <div class="cta">
          <a class="btn btn-accent" href="/es/blog/">Leer el blog</a>
          <a class="btn btn-ghost" href="/es/contacto/">Contacto</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container bio">
    <div class="bio-text">
      <h2>Sobre mí</h2>
      <p>
        Actualmente lidero iniciativas de transformación de cultura de ingeniería, seguimiento de
        métricas técnicas dentro de la compañía, y proyectos de IA aplicada — incluyendo el uso de
        GitHub Copilot en modo agente para remediar masivamente vulnerabilidades detectadas por
        Dependabot, caso que compartí en un evento conjunto de Credicorp, Microsoft y GitHub.
      </p>
    </div>

    {galleryImages.length > 0 && (
      <div class="bio-gallery">
        <p class="eyebrow gallery-eyebrow">Charlas y eventos</p>
        <PhotoCarousel
          images={galleryImages}
          alt="Juan Carlos Contreras dando una charla"
          closeLabel="Cerrar"
        />
      </div>
    )}
  </section>

  <section class="container certifications">
    <h2>Certificaciones</h2>
    <div class="cert-grid">
      {certifications.map((cert) => (
        <CertificationCard
          title={cert.title}
          issuer={cert.issuer}
          image={cert.image}
          alt={`Insignia de la certificación ${cert.title}`}
        />
      ))}
    </div>
  </section>

  <section class="container focus-grid">
    {focusAreas.map((area, index) => (
      <FocusAreaCard title={area.title} description={area.description} index={index} />
    ))}
  </section>

  {posts.length > 0 && (
    <section class="container latest">
      <h2>Últimos artículos</h2>
      <div class="post-grid">
        {posts.map((post) => (
          <BlogPostCard
            href={`/es/blog/${post.id.replace(/^es\//, '')}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            lang="es"
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(64px, 8vh, 110px) 1.5rem 130px;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .hero-photo {
    flex-shrink: 0;
    width: clamp(120px, 16vw, 180px);
    height: clamp(120px, 16vw, 180px);
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    border: 1px solid var(--hero-rule);
  }

  .hero-text {
    min-width: 0;
    flex: 1;
  }

  .lede {
    color: var(--hero-ink-2);
    font-size: 1.15rem;
    max-width: 34rem;
  }

  @media (max-width: 640px) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 100px;
    }
  }

  .hero-eyebrow {
    color: var(--hero-ink-3);
    padding-bottom: 14px;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--hero-rule);
  }

  .hero-title {
    font-size: clamp(40px, 5.4vw, 45px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 0 0 30px;
    color: var(--palette-bright-blue);
  }

  .cta {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cta .btn-accent {
    background: var(--hero-ink);
    color: var(--hero-bg);
    border-color: var(--hero-ink);
  }

  .cta .btn-ghost {
    border-color: var(--hero-rule);
    color: var(--hero-ink-2);
  }

  .cta .btn-ghost:hover {
    border-color: var(--hero-ink);
    color: var(--hero-ink);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    padding: 3rem 0;
  }

  .bio {
    max-width: var(--page-width);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    padding: 4rem 0 0 0;
  }

  .bio-text {
    min-width: 0;
    max-width: var(--content-width);
  }

  .bio-gallery {
    min-width: 0;
    max-width: 320px;
    width: 100%;
  }

  .gallery-eyebrow {
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .bio {
      grid-template-columns: 1fr;
    }

    .bio-gallery {
      max-width: 320px;
    }
  }

  .certifications {
    padding-bottom: 3rem;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .latest {
    padding-bottom: 4rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
