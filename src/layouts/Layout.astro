---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE } from '../config';
import { OG_WIDTH, OG_HEIGHT } from '../utils/og';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
  translationHref?: string;
  /** Página equivalente en el otro idioma. Solo si existe una traducción exacta (para hreflang). */
  alternateHref?: string;
  /** Ruta de la imagen para redes sociales; por defecto, la imagen general del idioma. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { lang, title, description, translationHref, alternateHref, image, type = 'website', publishedTime } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image ?? `/og/${lang}.png`, Astro.site);
const otherLang = lang === 'es' ? 'en' : 'es';
const alternateURL = alternateHref && new URL(alternateHref, Astro.site);
const locales = { es: 'es_PE', en: 'en_US' } as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternateURL && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalURL} />
        <link rel="alternate" hreflang={otherLang} href={alternateURL} />
        <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonicalURL : alternateURL} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locales[lang]} />
    {alternateURL && <meta property="og:locale:alternate" content={locales[otherLang]} />}
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body>
    <Header lang={lang} translationHref={translationHref} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <BackToTop lang={lang} />
  </body>
</html>
