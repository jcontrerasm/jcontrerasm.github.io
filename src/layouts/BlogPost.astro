---
import Layout from './Layout.astro';
import Mermaid from '../components/Mermaid.astro';
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../utils/slug';
import { formatDate } from '../utils/date';

interface Props {
  entry: CollectionEntry<'blog'>;
  translationHref?: string;
  alternateHref?: string;
}

const { entry, translationHref, alternateHref } = Astro.props;
const { title, description, pubDate, updatedDate, tags, lang, heroImage, status } = entry.data;

const formattedPubDate = formatDate(pubDate, lang);
const formattedUpdatedDate = updatedDate && formatDate(updatedDate, lang);
const updatedLabel = lang === 'es' ? 'Actualizado' : 'Updated';
// Solo llega a verse en `astro dev`: en producción los borradores no se generan
const draftLabel = lang === 'es' ? 'Borrador · no se publicará' : 'Draft · will not be published';
---

<Layout lang={lang} title={`${title} — ${lang === 'es' ? 'Artículos' : 'Articles'}`} description={description} translationHref={translationHref} alternateHref={alternateHref} image={`/og/${entry.id}.png`} type="article" publishedTime={pubDate}>
  <article class="container prose post">
    <header class="post-header">
      {heroImage && <img src={heroImage.src} alt="" class="hero" />}
      {status === 'draft' && <p class="draft-badge">{draftLabel}</p>}
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        {updatedDate && <span>· {updatedLabel} {formattedUpdatedDate}</span>}
      </div>
      <div class="tags">
        {tags.map((tag) => (
          <a class="tag-pill" href={`/${lang}/blog/tags/${slugify(tag)}/`}>
            {tag}
          </a>
        ))}
      </div>
    </header>
    <div class="body">
      <slot />
    </div>
  </article>
  <Mermaid lang={lang} />
</Layout>

<style>
  .post {
    padding: 2rem 1.5rem 3rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .hero {
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .draft-badge {
    display: inline-block;
    margin: 0 0 0.8rem;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: var(--color-accent-tint);
    border: 1px dashed var(--color-accent);
    border-radius: 6px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.8rem;
  }

  .body {
    line-height: 1.75;
  }

  .body :global(h2) {
    margin-top: 2em;
  }
</style>
